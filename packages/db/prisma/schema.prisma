// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int            @id @default(autoincrement())
  urlId       String         @unique
  name        String
  articleType String
  gender      String
  rating      Float //Static number
  imageUrl    String
  description String
  colour      String
  price       Float
  stock       Int            @default(0)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  images      ProductImage[] //1-Product -> x_amount-images (images stored in another table)
  orderItems  OrderItem[] //1-Product -> x_amount-orderItems (products can be in multiple orders)
  cartItems   CartItem[]  //1-Product -> x_amount-cartItems (products can be in multiple carts)
  sizeStocks  SizeStock[] //1-Product -> x_amount-sizeStocks (products can have multiple sizes with different stocks)
}

model SizeStock {
  id        Int        @id @default(autoincrement())
  productId Int
  size      String
  stock     Int        @default(0)
  cartItems CartItem[] 

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  url       String
  position  Int    @default(0)
  productId Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

//Copied what is expected for prisma-adapter needs for next-auth 
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  createdAt DateTime  @default(now())
  cart      Cart?
  accounts  Account[]
  sessions  Session[]
  orders    Order[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId]) //Ensures unique combination of provider and providerAccountId
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String   @id @default(cuid()) //collision resistant uid - "clh3x7...xxx"
  userId    String   @unique //one cart per user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

//Note to delete Cart knows to delete CartItems ->onDelete cascade
model CartItem {
  id          String   @id @default(cuid())
  cartId      String
  productId   Int
  sizeStockId Int
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeStock SizeStock @relation(fields: [sizeStockId], references: [id], onDelete: Cascade)
  cart      Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, sizeStockId]) //Ensures one entry per size stock in the cart
}

//Purchase history schemas starting from here
model Order {
  id              String   @id @default(cuid())
  userId          String
  totalAmount     Float
  status          String   @default("completed")
  stripeSessionId String   @unique //ENSURE one order per stripe session - stop from refreshing call duplicate
  createdAt       DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  productId       Int
  quantity        Int
  priceAtPurchase Float
  name            String

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}
